# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# NEWS_API_KEY: Required for real news API calls.
# Configured securely via Secrets panel in AI Studio UI.
NEWS_API_KEY=NEWS_API_KEY_PLACEHOLDER

# TWELVE_DATA_API_KEY: Required for Twelve Data market API calls.
TWELVE_DATA_API_KEY=TWELVE_DATA_API_KEY_PLACEHOLDER

# STOCK_API_KEY: Optional stock market API key for premium market data.
STOCK_API_KEY=STOCK_API_KEY_PLACEHOLDER
